/* === Thème clair moderne === */
* {
    font-family: "Inter", "Segoe UI", Arial, sans-serif;
    font-size: 12px;
    color: #111827;
}

QMainWindow {
    background-color: #F7F8FA;
}

QWidget {
    background: #F7F8FA;
}

QFrame, QGroupBox {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 6px 8px;
    font-weight: 600;
    color: #374151;
}

/* === Menu === */
QMenuBar {
    background: #F7F8FA;
    border: none;
    padding: 4px 12px;
}

QMenuBar::item {
    padding: 6px 14px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background: #EEF2FF;
    color: #1D4ED8;
}

QMenu {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    padding: 6px;
}

QMenu::item {
    padding: 6px 32px 6px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #EEF2FF;
    color: #1D4ED8;
}

/* === Barre d'outils principale === */
QToolBar#mainToolbar {
    background: #FFFFFF;
    border: none;
    padding: 16px 24px;
    spacing: 12px;
    border-bottom: 1px solid #E5E7EB;
    min-height: 78px;
}

QToolBar#mainToolbar::separator {
    width: 1px;
    margin: 0 6px;
    background: #E5E7EB;
}

QToolBar#mainToolbar QToolButton {
    background: transparent;
    border-radius: 10px;
    padding: 10px 16px;
    color: #374151;
    font-weight: 600;
    font-size: 13px;
}

QToolBar#mainToolbar QToolButton:hover {
    background: #F3F4F6;
    color: #1D4ED8;
}

QToolBar#mainToolbar QToolButton:checked,
QToolBar#mainToolbar QToolButton:pressed {
    background: #E0E7FF;
    color: #1D4ED8;
}

QLabel#toolbarSelection,
QLabel#toolbarSummary {
    background: #FFFFFF;
    color: #111827;
    padding: 6px 10px;
    border-radius: 8px;
    font-weight: 600;
    border: 1px solid #E5E7EB;
}

/* === Boutons === */
QPushButton {
    background: #3B82F6;
    color: #FFFFFF;
    border-radius: 6px;
    padding: 8px 16px;
    border: none;
    font-weight: 600;
}

QPushButton:hover {
    background: #2563EB;
}

QPushButton:pressed {
    background: #1D4ED8;
}

QPushButton:disabled {
    background: #A0AEC0;
    color: #E2E8F0;
}

/* === Inputs === */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 4px 6px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #3B82F6;
}

/* === Labels de statut === */
QLabel#measure_label {
    background: #FFFFFF;
    color: #111827;
    border-radius: 8px;
    padding: 8px 12px;
    border: 1px solid #E5E7EB;
    font-weight: 600;
}

QLabel#ortho_label {
    background: #DBEAFE;
    color: #1E3A8A;
    border-radius: 6px;
    padding: 4px 10px;
    font-weight: 600;
}

QLabel#ortho_label[ortho="true"] {
    background: #22C55E;
    color: #FFFFFF;
}

/* === Status bar & docks === */
QStatusBar {
    background: #FFFFFF;
    color: #374151;
    padding: 4px 12px;
    border-top: 1px solid #E5E7EB;
}

QStatusBar QLabel {
    margin-left: 8px;
}

QDockWidget {
    background: #F7F8FA;
    border: 1px solid #E5E7EB;
}

QDockWidget::title {
    background: #FFFFFF;
    color: #111827;
    font-weight: 600;
    padding: 6px 10px;
    border-bottom: 1px solid #E5E7EB;
}

/* === Tableaux & listes === */
QTableWidget {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    gridline-color: #E5E7EB;
    selection-background-color: #DBEAFE;
    selection-color: #111827;
}

QHeaderView::section {
    background: #F3F4F6;
    border: none;
    padding: 6px;
    font-weight: 600;
    color: #374151;
}

QTableWidget::item:selected {
    background: #DBEAFE;
    color: #111827;
}

QListWidget::item {
    border-radius: 6px;
    padding: 6px 8px;
}

QListWidget::item:selected {
    background: #EEF2FF;
    color: #111827;
}

/* === Scrollbar === */
QScrollBar:vertical {
    background: #F3F4F6;
    width: 10px;
    margin: 2px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}