# ============================================================
# Métraplan License Server — Configuration
# ============================================================
# Copiez ce fichier en ".env" et remplissez les valeurs.
# NE commitez JAMAIS le fichier .env dans git.
# ============================================================

# Clé secrète pour accéder au dashboard et aux routes admin
# Générez un secret fort : python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=CHANGEZ-MOI-ADMIN-SECRET-FORT

# Secret de signature des tokens JWT (doit rester identique si vous migrez la BDD)
# Générez un secret fort : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGEZ-MOI-JWT-SECRET-FORT
